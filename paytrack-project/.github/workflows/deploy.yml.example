# TEMPLATE ONLY. Rename to deploy.yml only after the cloud engineer has
# configured and reviewed the AWS OIDC role, Docker Hub secrets, and EC2 host.
name: PayTrack Deploy (template)
on:
  workflow_dispatch:
permissions:
  contents: read
  id-token: write
jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Configure AWS credentials with OIDC
        uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: ${{ secrets.AWS_DEPLOY_ROLE_ARN }}
          aws-region: ${{ vars.AWS_REGION }}
      - name: Log in to Docker Hub
        uses: docker/login-action@v3
        with:
          username: ${{ secrets.DOCKERHUB_USERNAME }}
          password: ${{ secrets.DOCKERHUB_TOKEN }}
      - name: Build and push API
        uses: docker/build-push-action@v6
        with:
          context: ./api
          push: true
          tags: ${{ secrets.DOCKERHUB_USERNAME }}/paytrack-api:latest
      - name: Build and push frontend
        uses: docker/build-push-action@v6
        with:
          context: ./frontend
          push: true
          tags: ${{ secrets.DOCKERHUB_USERNAME }}/paytrack-frontend:latest
      - name: Build and push worker
        uses: docker/build-push-action@v6
        with:
          context: ./worker
          push: true
          tags: ${{ secrets.DOCKERHUB_USERNAME }}/paytrack-worker:latest
      - name: Trigger deployment on EC2 using SSM
        env:
          INSTANCE_ID: ${{ vars.EC2_INSTANCE_ID }}
          AWS_REGION: ${{ vars.AWS_REGION }}
          DOCKERHUB_USERNAME: ${{ secrets.DOCKERHUB_USERNAME }}
        run: |
          set -euo pipefail
          test -n "$INSTANCE_ID"
          COMMAND_ID=$(aws ssm send-command             --instance-ids "$INSTANCE_ID"             --document-name "AWS-RunShellScript"             --comment "Deploy PayTrack from GitHub Actions"             --parameters commands='[
              "set -e",
              "cd /opt/paytrack",
              "git pull --ff-only",
              "docker compose pull api frontend worker",
              "docker compose up -d --remove-orphans",
              "docker compose ps"
            ]'             --query 'Command.CommandId' --output text)
          echo "SSM command started: $COMMAND_ID"
          echo "Inspect Systems Manager Run Command output before considering the release successful."
